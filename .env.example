# API
API_HOST=0.0.0.0
API_PORT=8000

# Retrieval/index services
QDRANT_URL=http://localhost:6333
POSTGRES_DSN=postgresql://postgres:postgres@localhost:5432/knowledge_copilot
REDIS_URL=redis://localhost:6379/0

# Model serving (set in later phases)
LLM_BASE_URL=http://localhost:8001/v1
LLM_API_KEY=replace-me
LLM_DEFAULT_BACKEND=vertex_ai
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_RECOVERY_TIMEOUT_SEC=60
CACHE_ENABLED=true
CACHE_TTL_SEC=3600

# App behavior
LOG_LEVEL=INFO
PROMPT_VERSION=concise

# Google Cloud Settings
GCP_PROJECT_ID=your-project-id
GCP_LOCATION=global
GCP_EMBEDDING_MODEL=gemini-embedding-2

GEMINI_API_KEY=your-api-key

GCP_GENERATION_MODEL=gemini-3.1-pro-preview
GCP_ROUTING_MODEL=gemini-3.1-flash-lite-preview
GCP_DECOMPOSITION_MODEL=gemini-3-flash-preview

# Security & Gateway
DEFAULT_API_KEY=your-secure-api-key
RATE_LIMIT_ASK=60
RATE_LIMIT_SEARCH=60
RATE_LIMIT_UPLOAD=10
RATE_LIMIT_DEFAULT=120

# Celery Ingestion Worker
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# JWT Settings
JWT_SECRET_KEY=replace-with-a-secure-secret-key
JWT_ALGORITHM=HS256