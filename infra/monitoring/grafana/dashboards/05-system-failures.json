      "id": 1,
      "title": "Error Count by Service and Type",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus"
          },
          "editorMode": "code",
          "expr": "sum(rate(system_failure_total_total[1m]) * 60) by (component, error_type) or sum(rate(system_failure_total[1m]) * 60) by (component, error_type)",
          "legendFormat": "{{component}} ({{error_type}})",
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus"
          },
          "editorMode": "code",
          "expr": "sum(rate(llm_requests_errors_total[1m]) * 60) by (model)",
          "legendFormat": "LLM {{model}} errors",
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus"
          },
          "editorMode": "code",
          "expr": "sum(rate(http_server_request_total_total{status=~\"5..\"}[1m]) * 60) by (endpoint)",
          "legendFormat": "FastAPI 5xx: {{endpoint}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line"
          },
          "unit": "errors/min"
        }
      }
    },
